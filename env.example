###############################################################################
# Reference for /opt/observability/.env
#
# This is NOT the working file. deploy-observability-stack.sh creates the real
# one on the first run (random Grafana password, detected HOST_IP, placeholder
# values) and later only appends keys that are missing — existing values are
# never changed.
#
# Parsing rules (identical for the script and docker compose):
#   KEY=value          no spaces around '='
#   KEY='va$lue'       single quotes: taken literally — REQUIRED if the value contains $
#   # comment          whole-line comments; "value  # comment" also works when unquoted
###############################################################################

# --- Loopback ports of the internal services ---
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
BLACKBOX_PORT=9115
NODE_EXPORTER_PORT=9100

# --- Host IP (auto-detected from the default route) ---
HOST_IP=203.0.113.10

# --- Network exposure ---
# Prometheus, Alertmanager and Blackbox have no authentication.
# 127.0.0.1 = local only (use an SSH tunnel); or a management/VPN IP.
# Avoid 0.0.0.0: Docker-published ports bypass UFW/iptables INPUT rules.
BIND_ADDR=127.0.0.1

# --- Traefik: the ONLY service published outside the host ---
# HTTPS -> Grafana; HTTP only redirects to HTTPS. Nothing else is published.
TRAEFIK_BIND_ADDR=0.0.0.0
TRAEFIK_HTTPS_PORT=443
TRAEFIK_HTTP_PORT=80
# What users type in the browser: certificate CN + Grafana root_url.
PUBLIC_HOST=203.0.113.10
# Extra certificate names (DNS or IP), comma-separated. Changing it re-issues the
# self-signed certificate (5 years) on the next run.
TLS_EXTRA_SANS=grafana.example.internal

# --- Local node-exporter listen IP. Empty = docker0 gateway (not reachable from the LAN) ---
NODE_EXPORTER_LISTEN_ADDR=

# --- Grafana (password applied on FIRST start only) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=generated_on_first_run

# --- Alertmanager → Telegram ---
# 1) @BotFather → token   2) add the bot to the chat, send a message,
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id (negative for channels)
# The token is written to alertmanager/secrets/telegram_bot_token (0400) and
# referenced via bot_token_file — it never appears in alertmanager.yml.
TELEGRAM_BOT_TOKEN=123456:AAAA-BBBBCCCCddddEEEEffffGGGGhhh
TELEGRAM_CHAT_ID=-1001234567890
# Base URL in alert links. Empty = http://HOST_IP:ALERTMANAGER_PORT
ALERTMANAGER_EXTERNAL_URL=

# --- Blackbox: HTTP(S) targets (self-signed certificates accepted) ---
BLACKBOX_TARGETS=https://example.com,https://internal-host.local:8443,http://192.0.2.30:80
# --- Blackbox: ICMP targets (host/IP, no port). Empty = disabled ---
BLACKBOX_ICMP_TARGETS=

# --- node_exporter targets (host:port, comma-separated) ---
NODE_EXPORTER_TARGETS=203.0.113.10:9100,203.0.113.15:9100

# --- Prometheus retention ---
PROMETHEUS_RETENTION=30d
# Size cap (e.g. 40GB). Oldest blocks are removed first. 0 = disabled.
PROMETHEUS_RETENTION_SIZE=0

# --- Optional resource limits (defaults shown) ---
#PROMETHEUS_MEM_LIMIT=2g
#PROMETHEUS_CPUS=1.0
#GRAFANA_MEM_LIMIT=512m
#TRAEFIK_MEM_LIMIT=256m
#TRAEFIK_CPUS=1.0
#ALERTMANAGER_MEM_LIMIT=256m
#BLACKBOX_MEM_LIMIT=128m
#NODE_EXPORTER_MEM_LIMIT=128m

# --- Extra exporters (docker-compose.override.yml) read their secrets from here too ---
# Example for examples/extra-exporters (postgres). Single quotes because of possible $.
#POSTGRES_EXPORTER_DSN='postgresql://postgres_exporter:change_me@203.0.113.20:5432/postgres?sslmode=require'
